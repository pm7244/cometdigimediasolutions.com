    <style>
      
     .containerr {
      display: flex;
      align-items: center;
      padding: 40px;
      gap: 30px;
      flex-wrap: wrap;
    } 

    .image-container {
      flex: 1;
      min-width: 300px;
    }

    .image-container img {
      width: 100%;
      border-radius: 6px;
      transition: opacity 0.3s ease-in-out;
    }

    .content-container {
      flex: 1;
      min-width: 300px;
    }

    .content-container h2 {
      font-size: 28px;
      font-weight: bold;
      color: black;
      margin-bottom: 15px;
    }

    .tabs {
      display: flex;
      gap: 20px;
      margin-bottom: 15px;
      border-bottom: 2px solid #eee;
    }

    .tab {
      padding: 8px 0;
      cursor: pointer;
      position: relative;
      font-weight: 500;
    }

    .tab.active {
      color: black;
    }

    .tab.active::after {
      content: "";
      position: absolute;
      bottom: -2px;
      left: 0;
      width: 100%;
      height: 2px;
      background: black;
    }

    .tab-content {
      display: none;
      margin-bottom: 20px;
      line-height: 1.6;
    }

    .tab-content.active {
      display: block;
    }

    </style>

