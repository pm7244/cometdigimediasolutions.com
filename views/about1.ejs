<!DOCTYPE html>
<html lang="en">
<!-- Added by HTTrack -->
<meta http-equiv="content-type" content="text/html;charset=UTF-8" /><!-- /Added by HTTrack -->

<head>
  <!-- Basic Meta Tags -->
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no" />
  <title>Blog Details</title>

  <!-- SEO Meta Tags -->
  <meta name="description"
    content="Quanto is a modern and creative agency template designed for businesses and freelancers to showcase their work." />
  <meta name="keywords" content="creative agency, modern template, business website, freelancer portfolio, Quanto" />

  <!-- Favicon -->
  <link rel="icon" href="/images/favicon.png" type="image/gif" />

  <!-- CSS Files -->
  <!-- Plugins CSS -->
  <link rel="stylesheet" href="/css/plugins.css" />
  <!-- Main Style CSS -->
  <link rel="stylesheet" href="/css/style.css" />
</head>

<body>
  <!-- Custom Cursor -->

  <div class="cursor d-none d-lg-block"></div>

  <!-- Custom Cursor End -->

  <!-- Preloader -->


  <!-- Header section Start -->
  <%- include('include/header') %>
    <!-- Header section End -->
    <div id="smooth-content">
      <!-- Blog Details section Start -->
      <section class="blog-page-sec blog-detail-page section-padding-bottom">
        <div class="container custom-container">
          <div class="row">
            <div class="col-12">
              <div class="blog-item-wrapper">
                <div class="blog-item blog-item-details">
                  <div class="row justify-content-center row-padding-bottom">
                    <div class="col-xl-9 col-xxl-9">
                      <div class="title-box blog-title move-anim" data-delay="0.45">
                        <h2>
                          <%= blog.blog_name %>

                        </h2>
                      </div>
                      <div class="meta-box">
                        <ul class="custom-ul meta-info d-flex">
                          <li>
                            <span>
                              <%= blog.formattedDate %>
                            </span>
                          </li>
                          <li>
                            <span>
                              <%= blog.type %>
                            </span>
                          </li>
                          <li>
                            <span>
                              <%= blog.blog_name %>
                            </span>
                          </li>
                        </ul>
                      </div>
                    </div>
                  </div>
                  <div class="img-box overflow-hidden">
                   
                    <img src="/<%= blog.hero_image %>" alt="blog" data-speed="0.8" class="w-100 d-block" />

                  </div>
                  <div class="content-box row-padding-top">
                    <div class="social-links">
                      <ul class="custom-ul">
                        <li>
                          <a href="#" target="_blank"><i class="fab fa-x-twitter"></i></a>
                        </li>
                        <li>
                          <a href="#" target="_blank"><i class="fab fa-instagram"></i></a>
                        </li>
                        <li>
                          <a href="#" target="_blank"><i class="fab fa-linkedin-in"></i></a>
                        </li>
                        <li>
                          <a href="#" target="_blank"><i class="fab fa-dribbble"></i></a>
                        </li>
                        <li>
                          <a href="#" target="_blank"><i class="fab fa-behance"></i></a>
                        </li>
                      </ul>
                    </div>
                    <div class="row justify-content-center social-links-scroll position-relative">

                      <div class="blog-body">
                        <div class="row justify-content-center social-links-scroll position-relative">
                          <div class="col-xl-9 col-xxl-8">
                            <div class="blog-body">

                              <!-- Blog Overview (single) -->
                              <p class="blog-text">
                                <%= blog.overview %>
                              </p>

                              <!-- Quote (single) -->
                              <!-- <blockquote>
                                <img src="/images/icons/blockquote.svg" alt="blockquote" />
                                <div class="text">
                                  <p>“<%= blog.quote %>”</p>
                                  <cite>─ <%= blog.author_name %></cite>
                                </div>
                              </blockquote> -->

                              <!-- Short Description (single) -->
                              <!-- <p class="blog-text"><%= blog.short_description %></p> -->

                              <!-- Loop through blogContent -->
                             <!-- Loop through blogContent -->
<% blogContent.forEach((content, index) => { %>
  <div class="blog-section">

    <!-- Text: handle single string or array -->
    <% let texts = Array.isArray(content.text) ? content.text : [content.text]; %>
    <% texts.forEach((desc, tIndex) => { %>
      <h4>sdghsjgjdh</h4>
      <p class="blog-text">
        <%= desc %>
      </p>
    <% }) %>

    <!-- Quote from blog_content -->
    <% if (content.quote) { %>
      <blockquote>
        <img src="/images/icons/blockquote.svg" alt="blockquote" />
        <div class="text">
          <p>“<%= content.quote %>”</p>
          <cite>─ <%= blog.author_name %></cite>
        </div>
      </blockquote>
    <% } %>

    <!-- Single image -->
    <% if (content.image && content.image.length > 0) { %>
      <% content.image.forEach((img, iIndex) => { %>
        <div class="quanto-single-thumb overflow-hidden">
          <img src="/<%= img %>" alt="blog-image-<%= index %>-<%= iIndex %>" class="w-100" />
        </div>
      <% }) %>
    <% } %>

    <!-- Multiple videos -->
    <% if (content.video && content.video.length > 0) { %>
      <% content.video.forEach((vid, vIndex) => { %>
        <div class="video-wrapper">
          <video muted autoplay loop controls src="/<%= vid %>"
            class="quanto-video d-block w-100 mb-2"
            id="video-<%= index %>-<%= vIndex %>">
          </video>
        </div>
      <% }) %>
    <% } %>

  </div>
<% }) %>


                            </div>
                          </div>
                        </div>



                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
      <!-- Blog Details section Start -->

      <!-- Blog section Start -->
      <section class="quanto-blog-section section-padding-bottom overflow-hidden">
        <div class="container custom-container">
          <div class="row">
            <div class="col-12">
              <div class="quanto__header text-center text-md-start row-padding-bottom">
                <h3 class="title fade-anim" data-delay="0.30" data-direction="left">
                  More articles
                </h3>
              </div>
            </div>
          </div>
          <div class="row gx-4 gy-5">







            <% relatedBlogs.forEach(item=> { %>
              <div class="col-md-6 col-lg-4">
                <div class="quanto-blog-box fade-anim" data-delay="0.60">
                  <div class="quanto-blog-thumb">
                    <a href="/blog/<%= item.blog_slug %>">
                      <img src="/<%= item.hero_image %>" alt="<%= item.blog_name %>" />
                    </a>
                  </div>
                  <div class="quanto-blog-content">
                    <h5 class="line-clamp-2">
                      <a href="/blog/<%= item.blog_slug %>">
                        <%= item.blog_name %>
                      </a>
                    </h5>
                    <span class="quanto-blog-date">
                      <%= item.formattedDate %>
                    </span>
                  </div>
                </div>
              </div>
              <% }) %>








          </div>
        </div>
      </section>
      <!-- Blog section End -->

      <!-- Footer section Start -->
      <%- include('include/Footer') %>
        <!-- Footer section End -->
    </div>
    </div>
    <!-- Jquery JS -->
    <script src="/js/jquery-3.7.1.min.js"></script>
    <!-- Bootstrap JS -->
    <script src="/js/bootstrap.bundle.min.js"></script>
    <!-- MixItUp JS -->
    <script src="/js/jquery.mixitup.min.js"></script>
    <!-- Swiper Carousel JS -->
    <script src="/js/swiper-bundle.min.js"></script>
    <!-- Magnific Popup JS -->
    <script src="/js/jquery.magnific-popup.min.js"></script>
    <!-- Odometer JS -->
    <script src="/js/odometer.min.js"></script>
    <script src="/js/viewport.jquery.js"></script>

    <!-- gsap JS -->
    <script src="/js/gsap.js"></script>
    <script src="/js/gsap-scroll-smoother.js"></script>
    <script src="/js/gsap-scroll-to-plugin.js"></script>
    <script src="/js/gsap-scroll-trigger.js"></script>
    <script src="/js/gsap-split-text.js"></script>

    <!-- Menu JS -->
    <script src="/js/menu.js"></script>

    <!-- Main JS -->
    <script src="/js/main.js"></script>
</body>

</html>