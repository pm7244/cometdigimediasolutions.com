<% ourteam.forEach((member, index) => { %>
<section class="quanto-team-details-section section-padding-top-bottom overflow-hidden">
  <div class="container custom-container">
    <div class="row g-4 justify-content-between">

      <% if (index % 2 === 0) { %>
        <!-- Left Image, Right Content -->
        <div class="col-xl-6 col-xxl-5">
          <div class="team-details__thumb">
            <% if (member.image.length > 0) { %>
          <img src="<%= member.image[0] %>" alt="team-details__thumb" data-speed="0.8" class="w-100" />
        <% } else { %>
          <img src="/images/default-team.png" alt="default" class="w-100" />
        <% } %>
          </div>
        </div>
        <div class="col-xl-6 col-xxl-6">
      <% } else { %>
        <!-- Left Content, Right Image -->
        <div class="col-xl-6 col-xxl-6">
      <% } %>

          <div class="team-details__content">
            <h2 class="member-title move-anim" data-delay="0.5">
              <%= member.name %>
            </h2>
            <h5 class="member-description move-anim" data-delay="0.7">
              <%= member.post %>
            </h5>
            <div class="member-info">
              <p class="fade-anim" data-delay="0.8">
                <%= member.des %>
              </p>
           
            </div>
            <div class="member-contacts">
              <% if (member.email) { %>
                <h5><a href="mailto:<%= member.email %>"><%= member.email %></a></h5>
              <% } %>
              <% if (member.phone) { %>
                <a href="tel:<%= member.phone %>"><%= member.phone %></a>
              <% } %>
            </div>
            <div class="member-social">
              <ul class="custom-ul">
                <% if (member.twitter) { %>
                  <li><a href="<%= member.twitter %>" target="_blank"><i class="fab fa-x-twitter"></i></a></li>
                <% } %>
                <% if (member.instagram) { %>
                  <li><a href="<%= member.instagram %>" target="_blank"><i class="fab fa-instagram"></i></a></li>
                <% } %>
                <% if (member.linkedin) { %>
                  <li><a href="<%= member.linkedin %>" target="_blank"><i class="fab fa-linkedin"></i></a></li>
                <% } %>
                <% if (member.behance) { %>
                  <li><a href="<%= member.behance %>" target="_blank"><i class="fab fa-behance"></i></a></li>
                <% } %>
                <% if (member.dribbble) { %>
                  <li><a href="<%= member.dribbble %>" target="_blank"><i class="fab fa-dribbble"></i></a></li>
                <% } %>
              </ul>
            </div>
          </div>
        </div>

      <% if (index % 2 !== 0) { %>
        <div class="col-xl-6 col-xxl-5">
          <div class="team-details__thumb">
            <img src="<%= member.image[0] || 'images/default.jpg' %>" 
                 alt="<%= member.name %>" data-speed="0.8" class="w-100" />
          </div>
        </div>
      <% } %>

    </div>
  </div>
</section>
<% }) %>






