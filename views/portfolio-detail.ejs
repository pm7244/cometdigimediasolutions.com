<!DOCTYPE html>
<html lang="en">
  <!-- Added by HTTrack --><meta http-equiv="content-type" content="text/html;charset=UTF-8" /><!-- /Added by HTTrack -->
<head>
    <!-- Basic Meta Tags -->
   <%- include('include/head') %>
  </head>

  <style>
  .portfolio-details-grid1 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px 60px; 
  max-width: 600px; 
}

.portfolio-details-box {
  display: flex;
  flex-direction: column;
}

.portfolio-details-box .title {
  display: block;

  color: #666;
  margin-bottom: 4px;
}



</style>

  <body>
    <!-- Custom Cursor -->

    <div class="cursor d-none d-lg-block"></div>

      <!-- Header section Start -->
  <%- include('include/header') %>
      <!-- Header section End -->
      <div id="smooth-content">
        <!-- Hero section Start -->
        <section
          class="quanto-hero-common-section section-padding-bottom overflow-hidden"
        >
          <div class="container custom-container">
            <div class="row g-4">
              <div class="col-lg-12 col-xxl-11">
                <div
                  class="quanto-hero-common__content move-anim"
                  data-delay="0.45"
                >
                  <h1 class="title"> <%= portfolio.title %></h1>
                </div>
              </div>
            </div>
          </div>
        </section>
        <!-- Hero section End -->

        <!-- Image section Start -->
        <div class="quanto-image-area style-2 overflow-hidden">
          <div class="container custom-container position-relative">
            <a
              href="#quanto-portfolio-details-section"
              class="scroll-down section-link"
            >
              Scroll down
              <img
                src="/images/icons/scroll-down.svg"
                alt="Scroll down"
              />
            </a>
            <div class="row">
              <div class="col-12">
           <!-- Video section Start -->
         <% if (portfolio.hero_video) { %>
<div class="quanto-video-area style-2 overflow-hidden">
  <div class="container custom-container">
    <div class="row">
      <div class="col-12">
        <video muted autoplay loop
          src="/<%= portfolio.hero_video %>"
          class="quanto-video d-block w-100"
          data-speed="0.8"
          id="quanto-video-2">
        </video>
        <button class="play-btn">Play</button>
      </div>
    </div>
  </div>
</div>
<% } %>

            <!-- Video section End -->
              </div>
            </div>
          </div>
        </div>
        <!-- Image section End -->

        <!-- Portfolio Details section Start -->
        <div
          id="quanto-portfolio-details-section"
          class="quanto-portfolio-details-section section-padding-top-bottom"
        >
          <div class="container custom-container">
            <div class="row g-4 justify-content-between">
              <div class="col-lg-4">
                <h2
                  class="portfolio-details__title move-anim"
                  data-delay="0.45"
                >
                  Project overview
                </h2>

                <div class="portfolio-details__info row-padding-top">
  <div class="portfolio-details-grid1">
    <!-- <div class="portfolio-details-box fade-anim" data-delay="0.2">
      <span class="title">Category</span>
      <h6 class="info"><%= portfolio.category %></h6>
    </div> -->
    <div class="portfolio-details-box fade-anim" data-delay="0.4">
      <span class="title">Service</span>
      <h6 class="info"><%= portfolio.service %></h6>
    </div>
    <!-- <div class="portfolio-details-box fade-anim" data-delay="0.6">
      <span class="title">Date</span>
      <h6 class="info"><%= portfolio.formattedDate %></h6>
    </div> -->
    <div class="portfolio-details-box fade-anim" data-delay="0.8">
      <span class="title">Client</span>
      <h6 class="info"><%= portfolio.client %></h6>
    </div>
    <div class="portfolio-details-box fade-anim" data-delay="1">
      <span class="title">platform</span>
      <h6 class="info"><%= portfolio.software %></h6>
    </div>
  </div>
</div>




              
              </div>
              <div class="col-lg-6">
                <div class="portfolio-details__content">
                  <p class="move-anim" data-delay="0.45">
                    <%= portfolio.des %>
                  </p>
                 
                   <!-- <a class='quanto-link-btn' href='/'>Visit live website
                    <span>
                      <i class="fa-solid fa-arrow-right arry1"></i>
                      <i class="fa-solid fa-arrow-right arry2"></i>
                    </span>
                  </a> -->
                </div>
           
              </div>
            </div>
            <div class="row g-3 g-lg-4 section-padding-top">

<% if (portfolio.list_img && Array.isArray(portfolio.list_img) && portfolio.list_img.length > 0) { %>
  <% portfolio.list_img.forEach(function(img) { %>
    <div class="col-sm-6 overflow-hidden">
      <img
        src="/<%= img %>"
        alt="portfolio-details-fig"
        data-speed="0.8"
        class="w-100"
      />
    </div>
  <% }); %>
<% } else { %>
  <p>No images found.</p>
<% } %>


<section>
  <div class="row" style="margin: 30px 0;">
    <% if (portfolio.challenges_des && portfolio.challenges_des.length > 0) { %>
      <div class="col-lg-6">
        <h4>Project Challenges</h4>
        <ul style="padding-top: 20px;">
          <% portfolio.challenges_des.forEach(function(challenge) { %>
            <li><%= challenge %></li>
          <% }) %>
        </ul>
      </div>
    <% } %>

    <% if (portfolio.results_des && portfolio.results_des.length > 0) { %>
      <div class="col-lg-6">
        <h4>Project Results</h4>
        <ul style="padding-top: 20px;">
          <% portfolio.results_des.forEach(function(result) { %>
            <li><%= result %></li>
          <% }) %>
        </ul>
      </div>
    <% } %>
  </div>
</section>

      

<% if (portfolio.big_list_img) { %>
  <div class="col-12 overflow-hidden">
    <img
      src="/<%= portfolio.big_list_img %>"
      alt="portfolio-details-fig"
      data-speed="0.8"
      class="w-100"
    />
  </div>
<% } %>


            </div>
          </div>
        </div>
        <!-- Portfolio Details section End -->

        <!-- Footer section Start -->
   <%- include('include/footer') %>
        <!-- Footer section End -->
      </div>
    </div>
    <!-- Jquery JS -->
    <script src="/js/jquery-3.7.1.min.js"></script>
    <!-- Bootstrap JS -->
    <script src="/js/bootstrap.bundle.min.js"></script>
    <!-- MixItUp JS -->
    <script src="/js/jquery.mixitup.min.js"></script>
    <!-- Swiper Carousel JS -->
    <script src="/js/swiper-bundle.min.js"></script>
    <!-- Magnific Popup JS -->
    <script src="/js/jquery.magnific-popup.min.js"></script>
    <!-- Odometer JS -->
    <script src="/js/odometer.min.js"></script>
    <script src="/js/viewport.jquery.js"></script>

    <!-- gsap JS -->
    <script src="/js/gsap.js"></script>
    <script src="/js/gsap-scroll-smoother.js"></script>
    <script src="/js/gsap-scroll-to-plugin.js"></script>
    <script src="/js/gsap-scroll-trigger.js"></script>
    <script src="/js/gsap-split-text.js"></script>

    <!-- Menu JS -->
    <script src="/js/menu.js"></script>

    <!-- Main JS -->
    <script src="/js/main.js"></script>
  </body>
</html>
