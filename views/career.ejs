        <!-- Career Gallery section Start -->
<div class="quanto-career-gallery-section overflow-hidden">
  <div class="container-fluid p-xl-0">
    <div class="row g-3 g-lg-4 career-gallery__row">

      <% 
        // Parse list_img JSON from career[0] directly
        let list_img = [];
        if (career[0] && career[0].list_img) {
          try {
            list_img = JSON.parse(career[0].list_img);
            // Handle double-encoded JSON if needed
            if (typeof list_img === "string") list_img = JSON.parse(list_img);
          } catch (e) {
            list_img = [];
          }
        }
      %>

      <% if (list_img.length > 0) { %>
        <% list_img.forEach((img, index) => { %>
          <div class="col-sm-6 col-md-4 col-lg-3">
            <div class="career-gallery-box">
              <img 
                src="/api/transform/<%= img %>" 
                alt="career-gallery-<%= index + 1 %>" 
                data-speed="0.8"
                class="w-100" 
              />
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <p class="text-center">No images available</p>
      <% } %>

    </div>
  </div>
</div>



        <!-- Career Gallery section Start -->

  


        
        <!-- Career section Start -->
<section id="quanto-career-section" class="quanto-career-section section-padding-top-bottom overflow-hidden">
  <div class="container custom-container">
    <div class="row gx-4 gy-5">
      <div class="col-lg-9 col-xxl-7">
        <div class="quanto__header row-padding-bottom text-center text-md-start">
          <h3 class="title move-anim">
            <%= career[0].career_title %>
          </h3>
        </div>
      </div>
    </div>
    <div class="row">
      <div class="col-12">

        <% if (careers.length > 0) { %>
          <% careers.forEach(job => { %>
            <div class="career-box fade-anim">
              <div class="career-left">
                <h5 class="job-title">
                  <%= job.title %>
                </h5>
                <p class="job-location">
                  <%= job.job_type %>
                </p>
              </div>
              <div class="career-center">
                <h5 class="apply-dateline">
                  <%= new Date(job.date_display).toLocaleDateString("en-US", { year: "numeric" , month: "long" , day: "numeric" }) %>
                </h5>
              </div>
              <div class="career-right">
                <a class='quanto-link-btn btn-pill' href='/careers/<%= job.slug %>'>
                  Apply Now
                  <span>
                    <i class="fa-solid fa-arrow-right arry1"></i>
                    <i class="fa-solid fa-arrow-right arry2"></i>
                  </span>
                </a>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <div class="no-jobs text-center py-5">
            <h5>No job openings available at the moment. Please check back later!</h5>
          </div>
        <% } %>

      </div>
    </div>
  </div>
</section>

