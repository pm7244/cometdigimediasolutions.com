<!DOCTYPE html>
<html lang="en">
<!-- Added by HTTrack -->
<meta http-equiv="content-type" content="text/html;charset=UTF-8" /><!-- /Added by HTTrack -->
<!-- Header section Start -->
<%- include('include/head') %>
  <!-- Header section End -->

  <body>
    <!-- Custom Cursor -->

    <div class="cursor d-none d-lg-block"></div>

      <!-- Header section Start -->
      <%- include('include/header') %>
        <!-- Header section End -->
        <div id="smooth-content">
          <!-- Hero section Start -->
          <section class="quanto-hero-service-section section-padding-bottom overflow-hidden">
            <div class="container custom-container">
              <div class="row g-4">
                <div class="col-lg-12 col-xxl-11">
                  <div class="quanto-hero-service__content move-anim" data-delay="0.45">
                    <h1 class="title">
                      <%= services[0].hero_title %>
                    </h1>
                  </div>
                </div>
              </div>
            </div>
          </section>
          <!-- Hero section End -->

          <!-- Video section Start -->
          <div class="quanto-video-area style-2 overflow-hidden">
            <div class="container custom-container position-relative">
              <a href="#service-section" class="scroll-down section-link">
                Scroll down
                <img src="/images/icons/scroll-down.svg" alt="Scroll down" />
              </a>

              <div class="row">
                <div class="col-12">


                  <div class="quanto-hero__thumb text-end">
                    <% if (services[0] && services[0].hero_image) { %>
                      <img src="<%= services[0].hero_image %>" alt="Service Hero Image"
                        class="d-block w-100" />
                      <% } %>
                  </div>

                </div>
              </div>
            </div>
          </div>
          <!-- Video section End -->

          <!-- Service section Start -->
          <section class="quanto-service4-section section-padding-top-bottom overflow-hidden" id="service-section">
            <div class="container custom-container">
              <div class="row gx-4 gy-5">
                <div class="col-md-10 col-lg-8 col-xxl-6">
                  <div class="quanto__header row-padding-bottom text-center text-md-start">
                    <h3 class="title move-anim">
                      <%= services[0].service_title %>
                    </h3>
                  </div>
                </div>
              </div>
              <div class="row">
                <div class="col-12">

                  <% servicesList.forEach((service, index)=> { %>
                    <div class="quanto-service-box4">
                      <h5 class="service-title">
                        <%= (index + 1).toString().padStart(2, '0' ) %> ─ <%= service.title %>
                      </h5>
                      <div class="service-info">
                        <p>
                          <%= service.short_des %>
                        </p>
                        <a class='quanto-link-btn' href="/services/<%= service.slug %>">
                          View details
                          <span>
                            <i class="fa-solid fa-arrow-right arry1"></i>
                            <i class="fa-solid fa-arrow-right arry2"></i>
                          </span>
                        </a>
                      </div>
                   <img src="/api/transform/<%= JSON.parse(service.icon)[0] %>" 
     alt="<%= service.title %> icon" width="60px">
                    </div>
                    <% }) %>

                </div>
              </div>
            </div>
          </section>
          <!-- Service section Start -->

          <!-- Image section Start -->
          <div class="quanto-image-area style-2 overflow-hidden">
            <div class="container-fluid px-0">
              <div class="row">
                <div class="col-12">
                  <div class="quanto-hero__thumb text-end">
                    <% if (services[0] && services[0].hero_image) { %>
                      <img src="<%= services[0].list_img %>" alt="Service Hero Image"
                        class="d-block w-100" />


                      <% } %>
                  </div>

                </div>
              </div>
            </div>
          </div>
          <!-- Image section End -->

          <!-- Clients section Start -->
          <div class="clients-area section-padding-top-bottom overflow-hidden">
            <div class="clients__wrapper">
              <div class="container custom-container">
                <div class="row align-items-end">
                  <div class="col-md-6">
                    <div class="quanto__header text-center text-md-start">
                      <p class="title mx-auto mx-md-0 fade-anim" data-delay="0.30" data-direction="left">
                        We worked with largest global brands
                      </p>
                    </div>
                  </div>
                  <div class="col-md-6 ps-md-0">
                    <div class="quanto__header logo">
                      <% clinetlogo.slice(0, 2).forEach(client=> { %>
                        <div class="client-box fade-anim" data-delay="0.30" data-direction="right">
                          <img src="<%= client.clogo %>" alt="client-logo" />
                        </div>
                        <% }) %>
                    </div>
                  </div>
                </div>
                <div class="row">
                  <div class="col-12 clients__box-wrapper">
                    <% clinetlogo.slice(2).forEach(client=> { %>
                      <div class="client-box fade-anim" data-delay="0.30" data-direction="right">
                        <img src="<%= client.clogo %>" alt="client-logo" />
                      </div>
                      <% }) %>

                        <!-- Final Plus Box -->
                        <div class="client-box fade-anim" data-delay="0.30" data-direction="right">
                          <img src="/images/clients/—Pngtree—button plus icon_3566853.jpg" alt="client-logo"
                            style="margin: 0 auto; width: 30%;" />
                          <p style="text-align: center;"><b>Be A Part Of This List</b></p>
                        </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <!-- Clients section End -->

          <!-- Footer section Start -->
          <%- include('include/footer') %>
            <!-- Footer section End -->
        </div>
    </div>
    <!-- Jquery JS -->
    <script src="/js/jquery-3.7.1.min.js"></script>
    <!-- Bootstrap JS -->
    <script src="/js/bootstrap.bundle.min.js"></script>
    <!-- MixItUp JS -->
    <script src="/js/jquery.mixitup.min.js"></script>
    <!-- Swiper Carousel JS -->
    <script src="/js/swiper-bundle.min.js"></script>
    <!-- Magnific Popup JS -->
    <script src="/js/jquery.magnific-popup.min.js"></script>
    <!-- Odometer JS -->
    <script src="/js/odometer.min.js"></script>
    <script src="/js/viewport.jquery.js"></script>

    <!-- gsap JS -->
    <script src="/js/gsap.js"></script>
    <script src="/js/gsap-scroll-smoother.js"></script>
    <script src="/js/gsap-scroll-to-plugin.js"></script>
    <script src="/js/gsap-scroll-trigger.js"></script>
    <script src="/js/gsap-split-text.js"></script>

    <!-- Menu JS -->
    <script src="/js/menu.js"></script>

    <!-- Main JS -->
    <script src="/js/main.js"></script>
  </body>

</html>