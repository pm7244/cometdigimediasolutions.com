    <div class="col-12 clients__box-wrapper">
  <% if (service.logo && service.logo.length > 0) { %>
    <% service.logo.forEach((logo, index) => { %>
      <div class="client-box fade-anim" data-delay="<%= 0.30 + (index * 0.15) %>" data-direction="right">
        <img src="/<%= logo %>" alt="client-logo" />
      </div>
    <% }) %>
  <% } %>
</div>

              </div>
            </div>
