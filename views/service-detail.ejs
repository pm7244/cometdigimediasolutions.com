    <script>
      // Wait until DOM is fully loaded
      document.addEventListener("DOMContentLoaded", function () {
        // Select all pricing boxes
        const boxes = document.querySelectorAll(".quanto-pricing-box");
        let maxHeight = 0;

        // Reset heights first
        boxes.forEach(box => box.style.height = "auto");

        // Find the tallest box
        boxes.forEach(box => {
          const boxHeight = box.offsetHeight;
          if (boxHeight > maxHeight) maxHeight = boxHeight;
        });

        // Set all boxes to the tallest height
        boxes.forEach(box => {
          box.style.height = maxHeight + "px";
        });
      });

      // Optional: recalc on window resize
      window.addEventListener("resize", function () {
        const boxes = document.querySelectorAll(".quanto-pricing-box");
        let maxHeight = 0;

        boxes.forEach(box => box.style.height = "auto");
        boxes.forEach(box => {
          const boxHeight = box.offsetHeight;
          if (boxHeight > maxHeight) maxHeight = boxHeight;
        });
        boxes.forEach(box => box.style.height = maxHeight + "px");
      });
    </script>

