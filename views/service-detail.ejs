          <!-- Work-process section Start -->
       <section class="work-process-section bg-color-primary section-padding-top-bottom overflow-hidden">
  <div class="container custom-container">
    <div class="row g-4">
      <div class="col-lg-10 col-xl-9 col-xxl-6">
        <div class="quanto__header h-100">
          <h3 class="title text-color-white text-center text-md-start fade-anim" data-delay="0.30"
            data-direction="left">
            Marketing Approach
          </h3>
        </div>
      </div>
    </div>

    <div class="row row-padding-top">
      <div class="col-12">
        <div class="process-box-wrapper horizontal-scroll">
          <% if (approach.length > 0) { %>
            <% approach.forEach(item => { %>
              <div class="process-box scroll-item">
                <span class="process-number"></span>
                <div class="process-info">
                  <h5 class="process-title text-color-white">
                    <%= item.title %> 
                  </h5>
                  <p class="text-color-white">
                    <%= item.des %>
                  </p>
                  
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <p class="text-white">No marketing approaches available.</p>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</section>

          <!-- Work-process section End -->



