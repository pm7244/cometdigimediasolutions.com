<!DOCTYPE html>
<html lang="en">
<!-- Added by HTTrack -->
<meta http-equiv="content-type" content="text/html;charset=UTF-8" /><!-- /Added by HTTrack -->
   <!-- Head section Start -->
       <%- include('include/head') %>
    <!-- Head section End -->

<body>
  <!-- Custom Cursor -->

  <div class="cursor d-none d-lg-block"></div>

    <!-- Head section Start -->
       <%- include('include/header') %>
    <!-- Head section End -->

    <!-- Header section End -->
    <div id="smooth-content">
      <!-- Hero section Start -->
      <section class="quanto-hero-section section-padding-bottom overflow-hidden">
        <div class="container custom-container">
          <div class="row g-4">
            <div class="col-lg-12 col-xxl-11">
              <div class="quanto-hero-common__content move-anim" data-delay="0.45">
                <h1 class="title"><%= contacts[0].hero_title %></h1>
              </div>
            </div>
          </div>
        </div>
      </section>
      <!-- Hero section End -->

      <!-- Map section Start -->
      <div class="quanto-map-area style-2 overflow-hidden">
        <div class="container custom-container position-relative">
          <a href="#quanto-contact-section" class="scroll-down section-link">
            Scroll down
            <img src="/images/icons/scroll-down.svg" alt="Scroll down" />
          </a>
          <div class="row">
            <div class="col-12">
           
<%- contacts[0].iframe %>
               
            </div>
          </div>
        </div>
      </div>
      <!-- Map section End -->

      <!-- Contact section Start -->
      <section id="quanto-contact-section" class="quanto-contact-section bg-color-white section-padding-top-bottom">
        <div class="container custom-container">
          <div class="row g-4 justify-content-between">
            <div class="col-lg-6 col-xxl-5">
              <div class="quanto-contact__content">
                <h3 class="title"><%=contacts[0].form_title %></h3>
                <p>
                    <%=contacts[0].form_des %>
                </p>
                <div class="address">
                  <h6>Address:</h6>
                  <span>
                    <%= addresses[0].address %>
                  </span>
                  <span>
                    <%= addresses[0].city %>
                  </span>
                </div>
                <div class="contact-info">
                <h5>
                  <a href="mailto:<%= addresses[0].email %>"><%= addresses[0].email %></a>
                </h5>
                <a href="tel:<%= addresses[0].phone_no %>">+91&nbsp;<%= addresses[0].phone_no %></a>
              </div>
              </div>
            </div>
            <div class="col-lg-6 col-xxl-6">
    <form id="contactForm" class="quanto-contact__form" autocomplete="off">
  <div class="row g-3 g-xl-4">
    <div class="col-md-6">
      <input type="text" name="name" placeholder="Your name" required class="form-control"
        pattern="[A-Za-z\s]+" title="Please enter only alphabets and spaces" />
    </div>
    <div class="col-md-6">
      <input type="text" name="company" placeholder="Company name" class="form-control" />
    </div>
    <div class="col-12">
      <input type="email" name="email" placeholder="Enter your e-mail address" required
        class="form-control" pattern="[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,}$"
        title="Please enter a valid email address" />
    </div>
    <div class="col-12">
      <input type="text" name="phone_no" placeholder="Your phone number"
        class="form-control" pattern="[0-9]{10}" title="Please enter a valid 10-digit phone number" />
    </div>
    <div class="col-12">
      <input type="text" name="enquiry" placeholder="What is the subject of your query?"
        class="form-control" />
    </div>
    <div class="col-12">
      <textarea name="message" rows="6" placeholder="Describe your project"
        class="form-control"></textarea>
    </div>
    <div class="col-12 mt-5">
      <button type="submit" class="quanto-link-btn btn-pill">
        Submit
        <span>
          <i class="fa-solid fa-arrow-right arry1"></i>
          <i class="fa-solid fa-arrow-right arry2"></i>
        </span>
      </button>
    </div>
    <div class="col-12">
      <p id="formMessage" style="margin-top:10px;"></p>
    </div>
  </div>
</form>

            </div>
          </div>
        </div>
      </section>
      <!-- Contact section End -->

      <!-- Footer section Start -->
    <!-- Head section Start -->
       <%- include('include/footer') %>
    <!-- Head section End -->

      <!-- Footer section End -->
    </div>
  </div>







<script>
document.getElementById("contactForm").addEventListener("submit", async function (e) {
  e.preventDefault(); 

  const formData = new FormData(this);
  const data = Object.fromEntries(formData.entries());

  const messageBox = document.getElementById("formMessage");
  const submitButton = this.querySelector('button[type="submit"]');
  
  messageBox.textContent = "Please wait...";
  messageBox.style.color = "#36644D";
  submitButton.disabled = true;
  submitButton.style.opacity = "0.6";
  submitButton.style.cursor = "not-allowed";

  await new Promise(resolve => setTimeout(resolve, 100));

  try {
    const res = await fetch("/api/createenquiries", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(data)
    });

    const result = await res.json();
    if (result.status) {
      messageBox.textContent = "Your enquiry has been sent successfully!";
      messageBox.style.color = "green";
      this.reset();
    } else {
      messageBox.textContent = "Failed to send enquiry: " + (result.error || "Unknown error");
      messageBox.style.color = "red";
    }
  } catch (err) {
    messageBox.textContent = "Error: " + err.message;
    messageBox.style.color = "red";
  } finally {
    submitButton.disabled = false;
    submitButton.style.opacity = "1";
    submitButton.style.cursor = "pointer";
  }
});
</script>

































































































  <!-- Jquery JS -->
  <script src="/js/jquery-3.7.1.min.js"></script>
  <!-- Bootstrap JS -->
  <script src="/js/bootstrap.bundle.min.js"></script>
