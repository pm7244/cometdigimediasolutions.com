<!DOCTYPE html>
<html lang="en">
<!-- Added by HTTrack -->
<meta http-equiv="content-type" content="text/html;charset=UTF-8" /><!-- /Added by HTTrack -->

<!-- Head section Start -->
<%- include('include/head') %>
  <!-- Head section End -->

  <body>
    <!-- Custom Cursor -->

    <div class="cursor d-none d-lg-block"></div>


      <!-- Header section Start -->
      <%- include('include/header') %>
        <!-- Header section End -->
        <div id="smooth-content">
          <!-- Hero section Start -->
          <section class="quanto-hero-faq-section section-padding-bottom overflow-hidden">
            <div class="container custom-container">
              <div class="row g-4">
                <div class="col-lg-12 col-xxl-11">
                  <div class="quanto-hero-common__content move-anim" data-delay="0.45">
                    <h1 class="title">
                      <%= portfolios[0].hero_title %>
                    </h1>
                  </div>
                </div>
              </div>
            </div>
          </section>
          <!-- Hero section End -->

          <!-- Project section Start -->
   <section class="quanto-project-section bg-color-white section-padding-bottom">
  <div class="container custom-container">
    <div class="row g-4 g-lg-5 justify-content-between align-items-center">
      <% project.forEach(proj => { %>
        <div class="col-md-6">
          <div class="quanto-project-box overflow-hidden">
            <a href="/portfolios/<%= proj.slug %>">
              <div class="quanto-project-thumb overflow-hidden">
                <img src="<%= proj.image %>" alt="project-thumb" class="w-100 img_reveal" />
              </div>
            </a>
            <div class="quanto-project-content">
              <h5 class="text-color-primary line-clamp-1">
                <a href="/portfolios/<%= proj.slug %>"><%= proj.title %></a>
              </h5>
              <% 
           let years = '', category = '';
if (proj.type) {
  let parts = proj.type.split('-');       // Split type by dash
  years = parts[0];                        // First part is the year
  category = parts.slice(1).join('-');     // Join the rest as full category
}
              %>
              <span class="quanto-project-date text-color-primary"><%= years %> - <%= category %></span>
            </div>
          </div>
        </div>
      <% }); %>
    </div>

    <!-- Pagination -->
    <div class="row">
      <div class="col-12">
        <div class="blog-pagination">
          <nav aria-label="Page navigation example">
            <ul class="pagination justify-content-end align-items-center custom-ul">

              <% if (currentPage > 1) { %>
                <li class="page-item">
                  <a class="page-link prev" href="/portfolio?page=<%= currentPage - 1 %>">
                    <i class="fa-solid fa-arrow-left"></i> Prev
                  </a>
                </li>
              <% } %>

              <% for (let i = 1; i <= totalPages; i++) { %>
                <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                  <a class="page-link" href="/portfolio?page=<%= i %>"><%= i %></a>
                </li>
              <% } %>

              <% if (currentPage < totalPages) { %>
                <li class="page-item">
                  <a class="page-link next" href="/portfolio?page=<%= currentPage + 1 %>">
                    Next <i class="fa-solid fa-arrow-right"></i>
                  </a>
                </li>
              <% } %>

            </ul>
          </nav>
        </div>
      </div>
    </div>
  </div>
</section>


          <!-- Project section End -->

          <!-- Footer section Start -->
          <%- include('include/footer') %>
            <!-- Footer section End -->
        </div>
    </div>
    <!-- Jquery JS -->
    <script src="/js/jquery-3.7.1.min.js"></script>
    <!-- Bootstrap JS -->
    <script src="/js/bootstrap.bundle.min.js"></script>
    <!-- MixItUp JS -->
    <script src="/js/jquery.mixitup.min.js"></script>
    <!-- Swiper Carousel JS -->
    <script src="/js/swiper-bundle.min.js"></script>
    <!-- Magnific Popup JS -->
    <script src="/js/jquery.magnific-popup.min.js"></script>
    <!-- Odometer JS -->
    <script src="/js/odometer.min.js"></script>
    <script src="/js/viewport.jquery.js"></script>

    <!-- gsap JS -->
    <script src="/js/gsap.js"></script>
    <script src="/js/gsap-scroll-smoother.js"></script>
    <script src="/js/gsap-scroll-to-plugin.js"></script>
    <script src="/js/gsap-scroll-trigger.js"></script>
    <script src="/js/gsap-split-text.js"></script>

    <!-- Menu JS -->
    <script src="/js/menu.js"></script>

    <!-- Main JS -->
    <script src="/js/main.js"></script>
  </body>

</html>